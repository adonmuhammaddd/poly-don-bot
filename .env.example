# Copy to .env and adjust. Never commit .env.

# ---- Database ----
POSTGRES_USER=poly
POSTGRES_PASSWORD=poly_dev_password
POSTGRES_DB=polybot
POSTGRES_URL=postgres://poly:poly_dev_password@localhost:5432/polybot?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Bot ----
BOT_ENV=dev
BOT_LOG_LEVEL=info
BOT_HTTP_PORT=8080
BOT_METRICS_PORT=9100

# ---- Binance (public WS, no auth needed) ----
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

# ---- Polymarket (public WS, no auth needed in Phase 1) ----
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/
POLYMARKET_REST_URL=https://clob.polymarket.com

# ---- Dashboard ----
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Telegram (Phase 3+, leave blank for Phase 1) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Polymarket auth (Phase 4+, leave blank for Phase 1) ----
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
